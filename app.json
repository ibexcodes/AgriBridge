{
  "expo": {
    "name": "AgriBridge",
    "slug": "AgriBridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/agribridge/app-icon.png",
    "scheme": "agribridge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/agribridge/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriBridge uses your location to show nearby farmers and listings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriBridge uses your photos to add images to marketplace listings.",
          "cameraPermission": "AgriBridge uses your camera to take marketplace listing photos.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
